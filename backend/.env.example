NODE_ENV=production
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://your-syncgrid-frontend.vercel.app

# Store driver: mongo | memory
STORE_DRIVER=mongo
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/syncgrid?retryWrites=true&w=majority

# Required in production: minimum 32 characters
JWT_SECRET=
JWT_TTL=12h
DEMO_PASSWORD=

SEQUENCER_TICK_MS=8
PERSIST_DEBOUNCE_MS=2000
PERSIST_MAX_WAIT_MS=10000

# 5000 rows x 10 columns = 50,000 cells
SEED_ROWS=5000
LOG_LEVEL=info
