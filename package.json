{
  "name": "syncgrid",
  "version": "1.0.0",
  "private": true,
  "description": "Event-sourced collaborative spreadsheet engine with cell-level masking and offline-first sync",
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=20" },
